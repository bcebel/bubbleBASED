
{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/join/:code",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|facebookexternalhit|Discordbot|Slackbot|TelegramBot|WhatsApp|LinkedInBot|Pinterestbot|Embedly|VKShare|Tumblr|Googlebot|bingbot|Applebot).*"
        }
      ],
      "destination": "https://minnowspacebackend-e6635e46c3d0.herokuapp.com/api/og/join/:code"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.(ico|png|jpg|jpeg|gif|svg|woff|woff2|js|css))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
