{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/media/:path*",
      "destination": "https://minnowspacebackend-e6635e46c3d0.herokuapp.com/api/media/:path*"
    },
    {
      "source": "/api/webseed/:path*",
      "destination": "https://minnowspacebackend-e6635e46c3d0.herokuapp.com/api/webseed/:path*"
    },
    {
      "source": "/((?!_expo|assets|.*\\..*$).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/media/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "1" }]
    },
    {
      "source": "/api/webseed/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "1" }]
    },
    {
      "source": "/webtorrent.min.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/:path*.(png|jpg|jpeg|gif|webp|avif|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
