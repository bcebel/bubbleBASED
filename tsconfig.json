{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "esModuleInterop": true,
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "components/Chat.js",
    "app/home.js",
    "components/ImagePicker.js",
    "app/webcamponent.js",
    "app/(tabs)/webcam.tsx",
    "app/(tabs)/index.js",
    "components/WebTorrentPlayer.js",
    "app/(tabs)/neighborhoods/bubbles/neighborhood-chat.js"
, "app/(tabs)/neighborhoods/staticParams.js", "components/WebTorrentMedia.tsx", "app/(tabs)/_layout.js"  ]
}
