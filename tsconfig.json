{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "esModuleInterop": true,
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "components/Chat.js",
    "app/home.js",
    "components/ImagePicker.js",
    "app/webcamponent.js",
    "app/(tabs)/webcam.tsx",
    "app/(tabs)/home.js",
    "components/WebTorrentPlayer.js",
    "components/neighborhood-chat.js",
    "components/_staticParams.js",
    "components/WebTorrentMedia.tsx",
    "app/(tabs)/_layout.js"
  ]
}
